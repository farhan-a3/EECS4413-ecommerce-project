# Frontend Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm install

# Copy frontend source code
COPY frontend/ ./

# Expose frontend port
EXPOSE 5173

# Start the frontend dev server with host flag so it's accessible outside container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]